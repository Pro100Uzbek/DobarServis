---
import Icon from './Icon.astro';
---

<div
	id="contact-modal"
	class="fixed inset-0 z-[100] hidden"
	role="dialog"
	aria-modal="true"
	aria-labelledby="modal-title"
	aria-describedby="modal-description"
	aria-hidden="true"
>
	<div
		data-modal-overlay
		class="absolute inset-0 bg-slate-900/60 opacity-0 backdrop-blur-sm transition-opacity duration-300"
	></div>
	<div class="relative flex min-h-full items-center justify-center overflow-y-auto p-4 sm:p-6">
		<div
			data-modal-panel
			class="relative w-full max-w-md scale-95 overflow-hidden rounded-2xl bg-white opacity-0 shadow-2xl transition-all duration-300"
		>
			<div class="relative border-b border-slate-100 bg-slate-50 p-5 sm:p-6">
				<button
					type="button"
					data-modal-close
					aria-label="Zatvori prozor"
					class="absolute right-4 top-4 grid h-8 w-8 place-items-center rounded-lg text-slate-400 transition hover:bg-slate-200 hover:text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
				>
					<Icon name="x" class="h-5 w-5" />
				</button>
				<div
					id="modal-service-badge"
					class="mb-3 inline-flex items-center gap-1.5 rounded-md bg-brand-light px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-brand-blue"
				>
					<Icon name="tag" class="h-3 w-3" />
					<span>Opšti upit</span>
				</div>
				<h2 id="modal-title" class="text-xl font-bold text-slate-900">
					Izaberite način komunikacije
				</h2>
				<p id="modal-description" class="mt-1 text-sm leading-relaxed text-slate-500">
					Bićete preusmjereni na online formular za prijavu kvara.
				</p>
			</div>

			<div class="space-y-2.5 p-5 sm:p-6">
				<a
					id="modal-whatsapp"
					href="https://wa.dobarservis.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="group flex items-center gap-3 rounded-xl bg-[#25D366] px-4 py-3.5 font-semibold text-white shadow-sm transition hover:bg-[#1EBE5A]"
				>
					<span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white/20">
						<Icon name="message-circle" class="h-5 w-5" />
					</span>
					<span class="flex-1">
						<span class="flex items-center justify-between">
							<span class="text-sm font-bold">WhatsApp</span>
							<span
								class="rounded bg-white px-1.5 py-0.5 text-[10px] font-extrabold uppercase text-[#1EBE5A]"
								>Najbrži</span
							>
						</span>
						<span class="mt-0.5 block text-[11px] font-medium text-white/90">
							Otvorite formular u WhatsApp-u
						</span>
					</span>
					<Icon name="chevron-right" class="h-5 w-5 shrink-0 opacity-70" />
				</a>

				<a
					id="modal-telegram"
					href="https://tg.dobarservis.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="group flex items-center gap-3 rounded-xl bg-[#229ED9] px-4 py-3.5 font-semibold text-white shadow-sm transition hover:bg-[#1C8DBF]"
				>
					<span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white/20">
						<Icon name="send" class="h-5 w-5" />
					</span>
					<span class="flex-1">
						<span class="block text-sm font-bold leading-tight">Telegram</span>
						<span class="mt-0.5 block text-[11px] font-medium leading-tight text-white/80">
							Pošaljite fotografije kvara
						</span>
					</span>
					<Icon name="chevron-right" class="h-5 w-5 shrink-0 opacity-70" />
				</a>

				<a
					id="modal-viber"
					href="https://viber.dobarservis.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="group flex items-center gap-3 rounded-xl bg-[#7360F2] px-4 py-3.5 font-semibold text-white shadow-sm transition hover:bg-[#6350E0]"
				>
					<span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white/20">
						<Icon name="phone-call" class="h-5 w-5" />
					</span>
					<span class="flex-1">
						<span class="block text-sm font-bold leading-tight">Viber</span>
						<span class="mt-0.5 block text-[11px] font-medium leading-tight text-white/80">
							Poruka ili poziv
						</span>
					</span>
					<Icon name="chevron-right" class="h-5 w-5 shrink-0 opacity-70" />
				</a>

				<div class="relative py-2">
					<div class="absolute inset-0 flex items-center">
						<div class="w-full border-t border-slate-200"></div>
					</div>
					<div class="relative flex justify-center">
						<span class="bg-white px-2 text-xs font-medium text-slate-400">ili</span>
					</div>
				</div>

				<a
					href="tel:+38267163499"
					class="group flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3.5 font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
				>
					<span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-slate-100 text-brand-dark">
						<Icon name="phone" class="h-5 w-5" />
					</span>
					<span class="flex-1">
						<span class="block text-sm font-bold leading-tight">Pozovite dispečera</span>
						<span class="mt-0.5 block text-[11px] font-medium leading-tight text-slate-500">
							+382 67 163 499
						</span>
					</span>
					<Icon name="chevron-right" class="h-5 w-5 shrink-0 text-slate-400" />
				</a>
			</div>
		</div>
	</div>
</div>

<div
	class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] lg:hidden"
>
	<button
		type="button"
		data-service="urgent"
		class="js-open-modal inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-blue py-3.5 text-sm font-bold text-white shadow-md transition active:scale-[0.98]"
	>
		<Icon name="wrench" class="h-5 w-5" />
		Prijavi kvar
	</button>
</div>

<script>
	const services = ['general', 'urgent', 'home', 'horeca', 'facility'] as const;
	type Service = (typeof services)[number];

	const serviceLabels: Record<Service, string> = {
		general: 'Opšti upit',
		urgent: 'Hitna intervencija',
		home: 'Kućni aparati',
		horeca: 'HoReCa oprema',
		facility: 'Vile i objekti',
	};

	const serviceHosts = [
		{ id: 'modal-whatsapp', host: 'https://wa.dobarservis.com/' },
		{ id: 'modal-telegram', host: 'https://tg.dobarservis.com/' },
		{ id: 'modal-viber', host: 'https://viber.dobarservis.com/' },
	] as const;

	function isService(value: string | null | undefined): value is Service {
		return services.some((service) => service === value);
	}

	function getRequiredElement<T extends Element>(selector: string): T {
		const element = document.querySelector<T>(selector);
		if (!element) throw new Error(`Contact modal element not found: ${selector}`);
		return element;
	}

	const modal = getRequiredElement<HTMLElement>('#contact-modal');
	const overlay = getRequiredElement<HTMLElement>('[data-modal-overlay]');
	const panel = getRequiredElement<HTMLElement>('[data-modal-panel]');
	const serviceBadge = getRequiredElement<HTMLElement>('#modal-service-badge span');
	const channelLinks = serviceHosts.map(({ id, host }) => ({
		link: getRequiredElement<HTMLAnchorElement>(`#${id}`),
		host,
	}));
	const pageLanguage = document.documentElement.dataset.lang || 'sr-ME';
	const pageCity = document.documentElement.dataset.city || '';
	let currentService: Service = 'general';
	let lastFocusedElement: HTMLElement | null = null;

	function getFocusableElements(): HTMLElement[] {
		return Array.from(
			modal.querySelectorAll<HTMLElement>(
				'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
			),
		).filter((element) => element.getClientRects().length > 0);
	}

	function updateMessengerLinks() {
		const query = new URLSearchParams({
			service: currentService,
			lang: pageLanguage,
		});
		if (pageCity) query.set('city', pageCity);

		for (const { link, host } of channelLinks) {
			link.href = `${host}?${query.toString()}`;
		}
	}

	function openModal(service: string | null | undefined, trigger: HTMLElement | null) {
		currentService = isService(service) ? service : 'general';
		serviceBadge.textContent = serviceLabels[currentService];
		updateMessengerLinks();
		lastFocusedElement = trigger;
		modal.classList.remove('hidden');
		modal.setAttribute('aria-hidden', 'false');
		document.body.classList.add('overflow-hidden');

		window.requestAnimationFrame(() => {
			overlay.classList.replace('opacity-0', 'opacity-100');
			panel.classList.replace('opacity-0', 'opacity-100');
			panel.classList.replace('scale-95', 'scale-100');
		});

		window.setTimeout(() => {
			if (modal.classList.contains('hidden')) return;
			getFocusableElements()[0]?.focus();
		}, 300);
	}

	function closeModal() {
		if (modal.classList.contains('hidden')) return;

		modal.setAttribute('aria-hidden', 'true');
		document.body.classList.remove('overflow-hidden');
		overlay.classList.replace('opacity-100', 'opacity-0');
		panel.classList.replace('opacity-100', 'opacity-0');
		panel.classList.replace('scale-100', 'scale-95');

		window.setTimeout(() => {
			modal.classList.add('hidden');
			lastFocusedElement?.focus();
		}, 280);
	}

	modal.addEventListener('keydown', (event) => {
		if (event.key !== 'Tab') return;

		const focusable = getFocusableElements();
		const first = focusable[0];
		const last = focusable[focusable.length - 1];

		if (!first || !last) {
			event.preventDefault();
			return;
		}

		if (event.shiftKey && (document.activeElement === first || !modal.contains(document.activeElement))) {
			event.preventDefault();
			last.focus();
		} else if (
			!event.shiftKey &&
			(document.activeElement === last || !modal.contains(document.activeElement))
		) {
			event.preventDefault();
			first.focus();
		}
	});

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const opener = event.target.closest<HTMLElement>('.js-open-modal');
		if (!opener) return;

		event.preventDefault();
		openModal(opener.dataset.service, opener);
	});

	overlay.addEventListener('click', (event) => {
		if (event.target === overlay) closeModal();
	});

	modal.querySelectorAll<HTMLButtonElement>('[data-modal-close]').forEach((button) => {
		button.addEventListener('click', closeModal);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeModal();
	});

	const deepLinkService = new URLSearchParams(window.location.search).get('service');
	if (deepLinkService && isService(deepLinkService)) openModal(deepLinkService, null);
</script>
