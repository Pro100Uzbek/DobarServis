---
import Icon from './Icon.astro';

interface Props {
	service?: 'general' | 'urgent' | 'home' | 'horeca' | 'facility';
	title?: string;
	subtitle?: string;
}

const {
	service = 'general',
	title = 'Trebate servis ili provjeru opreme?',
	subtitle = 'Pozovite nas ili pošaljite poruku — odgovaramo u radno vrijeme.',
} = Astro.props;
---

<section class="bg-brand-dark py-12">
	<div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:px-6 lg:flex-row lg:px-8">
		<div>
			<h2 class="text-2xl font-bold text-white">{title}</h2>
			<p class="mt-2 text-slate-300">{subtitle}</p>
		</div>
		<div class="flex w-full gap-3 md:w-auto">
			<a
				href="tel:+38267163499"
				class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-white px-6 py-3 font-bold text-brand-dark transition hover:bg-slate-100 md:flex-none"
			>
				<Icon name="phone" class="h-4 w-4" /> Pozovi
			</a>
			<button
				type="button"
				data-service={service}
				class="js-open-modal inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-brand-blue px-6 py-3 font-bold text-white transition hover:bg-blue-500 md:flex-none"
			>
				<Icon name="wrench" class="h-4 w-4" /> Prijavi kvar
			</button>
		</div>
	</div>
</section>
