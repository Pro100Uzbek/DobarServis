---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { buildSeoConfig } from '../utils/seo';
import { Image } from 'astro:assets';
import heroImg from '../assets/img/TehnicarDS.webp';

const seo = buildSeoConfig({
	title: 'Dobar Servis — Popravka bele tehnike, HoReCa opreme i održavanje objekata',
	description:
		'Brza popravka kućnih aparata, servis profesionalne opreme za restorane i tehničko održavanje vila na primorju i u Podgorici. Garancija do 12 mjeseci. ☎ +382 67 163 499',
	path: '/',
	lang: 'sr-ME',
	service: 'general',
	ogImage: '/TehnicarDS.webp',
});
---

<Layout seo={seo}>
  <Header slot="header" />
    <!-- HERO -->
    <section class="relative overflow-hidden bg-brand-dark text-white py-12 sm:py-16 lg:py-20">
      <div class="pointer-events-none absolute inset-0 opacity-[0.05]" style="background-image:linear-gradient(to right,#fff 1px,transparent 1px),linear-gradient(to bottom,#fff 1px,transparent 1px);background-size:64px 64px;"></div>
      <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-brand-blue/20 blur-3xl"></div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- ЛЕВАЯ ЧАСТЬ: Текст и Кнопки -->
          <div class="lg:col-span-7 flex flex-col justify-center">
            <span class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-800/60 px-4 py-1.5 text-xs font-semibold text-slate-300 w-fit">
              <Icon name="check-circle-2" class="h-4 w-4 text-brand-blue animate-pulse" />
              Radimo od 2021. • 500+ izvršenih radova • Garancija do 12 mjeseci
            </span>
            <h1 class="mt-6 text-3xl font-extrabold leading-[1.15] tracking-tight sm:text-4xl lg:text-5xl xl:text-[3.25rem]">
              Profesionalni tehnički servis koji rješava problem iz prvog puta
            </h1>
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
              Popravka kućnih aparata, hitni servis ugostiteljske opreme i tehničko vođenje nekretnina. Dolazimo na adresu od Ulcinja do Herceg Novog i u Podgorici sa okolinom. Jasna cijena prije početka rada, fiskalni račun i garancija do 12 mjeseci.
            </p>
            <div class="mt-8 flex flex-col items-stretch justify-start gap-3 sm:flex-row sm:items-center">
              <button type="button" data-service="general" class="js-open-modal inline-flex items-center justify-center gap-2 rounded-xl bg-brand-blue px-6 py-3.5 text-sm font-semibold text-white shadow-xl shadow-brand-blue/20 transition hover:bg-blue-500 transform active:scale-95">
                <Icon name="wrench" class="h-5 w-5" /> Prijavi kvar
              </button>
              <a href="tel:+38267163499" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-600 bg-slate-800/40 px-6 py-3.5 text-sm font-semibold text-white transition hover:border-slate-400 hover:bg-slate-700">
                <Icon name="phone" class="h-5 w-5" /> +382 67 163 499
              </a>
            </div>
          </div>

          <!-- ПРАВАЯ ЧАСТЬ: Изображение с мастером и фургоном + Плашка -->
          <div class="lg:col-span-5 relative w-full mt-10 lg:mt-0">
            
            <!-- Контейнер для картинки и плашки -->
            <div class="flex flex-col gap-4">
              
              <!-- Адаптивная обертка для фото -->
              <div class="relative aspect-[3/2] md:aspect-[4/3] w-full rounded-2xl overflow-hidden shadow-2xl border border-slate-700/60 bg-slate-900 group">
                <!-- Новое изображение -->
                <Image
                  src={heroImg}
                  widths={[640, 960, 1280, 1600]}
                  sizes="(min-width: 1024px) 42vw, 100vw"
                  format="avif"
                  quality={75}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  alt="Tehničar Dobar Servis sa opremom i servisnim vozilom ispred vile u Crnoj Gori" 
                  class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
                />
                <!-- Градиентное затемнение -->
                <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/95 via-transparent to-transparent opacity-90"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-brand-dark/10 via-transparent to-brand-dark/10"></div>
              </div>

              <!-- Плашка-бэйдж (теперь под картинкой) -->
              <div class="bg-slate-800/80 backdrop-blur-md border border-slate-700/50 p-4 rounded-xl flex flex-col sm:flex-row sm:items-center gap-3 shadow-lg">
                <div class="h-10 w-10 bg-brand-blue rounded-lg flex items-center justify-center shrink-0 shadow-lg shadow-brand-blue/30">
                  <Icon name="truck" class="h-5 w-5 text-white" />
                </div>
                <div>
                  <p class="text-white font-bold text-sm tracking-wide">Mobilni servis i brzi izlasci do 24h*</p>
                  <p class="text-slate-400 text-[11px] leading-snug mt-1">*Po prethodnom dogovoru, u zavisnosti od lokacije i dostupnosti (usluga se naplaćuje).</p>
                </div>
              </div>

            </div>

            <!-- Декоративный световой эффект -->
            <div class="pointer-events-none absolute -left-12 -bottom-12 h-48 w-48 rounded-full bg-brand-blue/10 blur-2xl z-0"></div>
          </div>

        </div>
      </div>
    </section>

    <!-- KAKO RADIMO -->
    <section class="bg-slate-50 py-12 border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <h2 class="text-2xl font-bold text-slate-900">Kako funkcioniše servis?</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-center">
          <div class="relative flex flex-col items-center">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-brand-blue text-brand-blue flex items-center justify-center font-bold text-lg mb-3 shadow-sm z-10">1</div>
            <h3 class="text-sm font-bold text-slate-800">Prijava kvara</h3>
            <p class="text-xs text-slate-500 mt-1">Poziv ili poruka</p>
            <div class="hidden md:block absolute top-6 left-[60%] w-[80%] h-[2px] bg-slate-200"></div>
          </div>
          <div class="relative flex flex-col items-center">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center font-bold text-lg mb-3 shadow-sm z-10">2</div>
            <h3 class="text-sm font-bold text-slate-800">Dijagnostika</h3>
            <p class="text-xs text-slate-500 mt-1">Dolazak na adresu</p>
            <div class="hidden md:block absolute top-6 left-[60%] w-[80%] h-[2px] bg-slate-200"></div>
          </div>
          <div class="relative flex flex-col items-center">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center font-bold text-lg mb-3 shadow-sm z-10">3</div>
            <h3 class="text-sm font-bold text-slate-800">Predračun</h3>
            <p class="text-xs text-slate-500 mt-1">Jasna cijena</p>
            <div class="hidden md:block absolute top-6 left-[60%] w-[80%] h-[2px] bg-slate-200"></div>
          </div>
          <div class="relative flex flex-col items-center">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center font-bold text-lg mb-3 shadow-sm z-10">4</div>
            <h3 class="text-sm font-bold text-slate-800">Popravka</h3>
            <p class="text-xs text-slate-500 mt-1">Brza intervencija</p>
            <div class="hidden md:block absolute top-6 left-[60%] w-[80%] h-[2px] bg-slate-200"></div>
          </div>
          <div class="flex flex-col items-center">
            <div class="h-12 w-12 rounded-full bg-brand-dark text-white flex items-center justify-center mb-3 shadow-md z-10"><Icon name="check" class="h-6 w-6" /></div>
            <h3 class="text-sm font-bold text-slate-800">Garancija</h3>
            <p class="text-xs text-slate-500 mt-1">Fiskalni račun</p>
          </div>
        </div>
      </div>
    </section>

    <!-- KEY SERVICES -->
    <section id="b2b" class="scroll-mt-24 bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-blue">Naša ekspertiza</p>
          <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl">Tri pravca servisne podrške</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
          <!-- Card 1 -->
          <article class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-xl sm:p-8">
            <div class="flex items-center justify-between mb-4">
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-slate-100 text-slate-700 transition group-hover:bg-brand-dark group-hover:text-white">
                <Icon name="washing-machine" class="h-6 w-6" />
              </span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">B2C</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 sm:text-xl">Servis Kućnih Aparata</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">Brza dijagnostika i popravka frižidera, veš mašina, mašina za pranje sudova, bojlera i šporeta na vašoj adresi. Obezbjeđujemo rezervne dijelove.</p>
            <div class="mt-6 pt-6 border-t border-slate-100 mt-auto">
              <button type="button" data-service="home" class="relative z-10 js-open-modal inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-blue px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark">
                <Icon name="calendar-check" class="h-4 w-4" /> Zakaži majstora
              </button>
            </div>
            <a href="/kucni-aparati/" aria-label="Detaljnije o servisu kućnih aparata" class="absolute inset-0 z-0"></a>
          </article>

          <!-- Card 2 -->
          <article class="group relative flex flex-col rounded-2xl border-2 border-brand-blue/30 bg-gradient-to-b from-white to-brand-light/30 p-6 shadow-md transition duration-300 hover:-translate-y-1 hover:border-brand-blue hover:shadow-xl sm:p-8">
            <div class="absolute top-0 inset-x-0 h-1 bg-brand-blue rounded-t-2xl"></div>
            <div class="flex items-center justify-between mb-4 mt-1">
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-blue text-white shadow-lg shadow-brand-blue/25">
                <Icon name="chef-hat" class="h-6 w-6" />
              </span>
              <span class="rounded-full bg-brand-blue/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-brand-blue">Pravna lica</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 sm:text-xl">HoReCa &amp; Komercijalna Oprema</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">Servis rashladnih vitrina, komora, ledomata, točionika i parokonvekcijskih peći. Ugovori o održavanju i prioritetni izlasci kako vaša kuhinja ne bi stala.</p>
            <div class="mt-6 pt-6 border-t border-brand-blue/10 mt-auto">
              <button type="button" data-service="horeca" class="relative z-10 js-open-modal inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-blue px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark">
                <Icon name="clipboard-list" class="h-4 w-4" /> Zahtev za servis
              </button>
            </div>
            <a href="/horeca/" aria-label="Detaljnije o HoReCa servisu" class="absolute inset-0 z-0"></a>
          </article>

          <!-- Card 3 -->
          <article class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-xl sm:p-8 md:col-span-2 lg:col-span-1">
            <div class="flex items-center justify-between mb-4">
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-slate-100 text-slate-700 transition group-hover:bg-brand-dark group-hover:text-white">
                <Icon name="building-2" class="h-6 w-6" />
              </span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">Facility</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 sm:text-xl">Tehničko Održavanje Vila i Objekata</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">Jedan odgovorni tehnički kontakt za nadzor inženjerskih sistema, bazenske tehnike, organizaciju majstora i transparentne foto-izvještaje.</p>
            <div class="mt-6 pt-6 border-t border-slate-100 mt-auto">
              <button type="button" data-service="facility" class="relative z-10 js-open-modal inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-blue px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark">
                <Icon name="messages-square" class="h-4 w-4" /> Konsultacija
              </button>
            </div>
            <a href="/odrzavanje-vila/" aria-label="Detaljnije o održavanju vila i objekata" class="absolute inset-0 z-0"></a>
          </article>
        </div>
      </div>
    </section>

    <!-- O NAMA / TRUST -->
    <section id="o-nama" class="scroll-mt-24 border-y border-slate-200 bg-slate-50 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-blue">O nama</p>
            <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Šta dobijate sa Dobar Servisom</h2>
            <p class="mt-4 text-base leading-relaxed text-slate-600">Inženjerski pristup, transparentna dokumentacija i pouzdane komponente na svakom izlasku. Radimo od 2021. godine.</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">Trenutno smo u procesu dobijanja licence za rukovanje freonom.</p>
            <div class="mt-8 grid grid-cols-2 gap-6">
              <div><p class="text-3xl font-extrabold text-brand-dark">500+</p><p class="text-sm font-medium text-slate-600 mt-1">Izvršenih radova</p></div>
              <div><p class="text-3xl font-extrabold text-brand-dark">24h*</p><p class="text-sm font-medium text-slate-600 mt-1">Hitni izlasci (uz dogovor)</p></div>
              <div><p class="text-3xl font-extrabold text-brand-dark">12</p><p class="text-sm font-medium text-slate-600 mt-1">Mjeseci garancije na sve popravke</p></div>
              <div><p class="text-2xl font-extrabold text-brand-dark">Područja usluge</p><p class="text-sm font-medium text-slate-600 mt-1 leading-relaxed">Ulcinj • Bar • Sutomore • Petrovac • Budva • Tivat • Kotor • Herceg Novi • Podgorica i okolna mjesta prema primorju</p></div>
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-light text-brand-blue mb-3"><Icon name="receipt" class="h-5 w-5" /></span><h3 class="text-sm font-bold text-slate-900">Fiskalni račun</h3><p class="mt-1 text-xs leading-relaxed text-slate-600">Potpuna usklađenost sa zakonodavstvom CG.</p></div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-light text-brand-blue mb-3"><Icon name="file-text" class="h-5 w-5" /></span><h3 class="text-sm font-bold text-slate-900">Zvanični akti</h3><p class="mt-1 text-xs leading-relaxed text-slate-600">Zapisnik o defektaži, nalog za rad, predračun.</p></div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-light text-brand-blue mb-3"><Icon name="shield-check" class="h-5 w-5" /></span><h3 class="text-sm font-bold text-slate-900">Garancija</h3><p class="mt-1 text-xs leading-relaxed text-slate-600">Garancija do 12 mjeseci na izvršene radove i ugrađene dijelove.</p></div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-light text-brand-blue mb-3"><Icon name="map-pin" class="h-5 w-5" /></span><h3 class="text-sm font-bold text-slate-900">Pokrivenost</h3><p class="mt-1 text-xs leading-relaxed text-slate-600">Cijelo primorje i Podgorica sa okolinom.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- BRANDS -->
    <section class="bg-white py-12 border-b border-slate-100 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-6"><p class="text-center text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Radimo sa opremom vodećih proizvođača</p></div>
      <div class="relative flex overflow-x-hidden group">
        <div class="animate-marquee whitespace-nowrap flex items-center gap-12 sm:gap-20 opacity-50 group-hover:opacity-100 transition-opacity duration-300">
          <span class="text-2xl font-black text-slate-400 tracking-tighter">Rational</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Unox</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Forcar</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Bosch</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Miele</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Electrolux</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Carrier</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Zanussi</span>
        </div>
        <div class="absolute top-0 animate-marquee2 whitespace-nowrap flex items-center gap-12 sm:gap-20 opacity-50 group-hover:opacity-100 transition-opacity duration-300">
          <span class="text-2xl font-black text-slate-400 tracking-tighter">Rational</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Unox</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Forcar</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Bosch</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Miele</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Electrolux</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Carrier</span><span class="text-2xl font-black text-slate-400 tracking-tighter">Zanussi</span>
        </div>
      </div>
    </section>

  <CtaBlock service="urgent" />
  <Footer slot="footer" />
  <ContactModal slot="modal" />
</Layout>
