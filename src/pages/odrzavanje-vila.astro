---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---

<Layout title="Tehničko održavanje vila i nekretnina | Dobar Servis Crna Gora" description="Preuzimamo odgovornost za tehničko stanje vaše nekretnine. Redovni obilasci, kontrola inženjerskih sistema i organizacija majstora uz foto-izvještaje. ☎ +382 67 163 499">
  <Header />
<main>
    <!-- HERO -->
    <section class="relative overflow-hidden bg-brand-dark text-white py-16 lg:py-24">
      <div class="pointer-events-none absolute inset-0 opacity-[0.05]" style="background-image:linear-gradient(to right,#fff 1px,transparent 1px),linear-gradient(to bottom,#fff 1px,transparent 1px);background-size:64px 64px;"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-800/60 px-4 py-1.5 text-xs font-semibold text-slate-300">
              <i data-lucide="building-2" class="h-4 w-4 text-brand-blue"></i> Za vlasnike vila, kuća i apartmana
            </span>
            <h1 class="mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">Sigurnost i mir za vašu nekretninu u Crnoj Gori</h1>
            <p class="mt-5 text-lg text-slate-300 leading-relaxed max-w-2xl">Delegirajte nam brigu o vašoj vili ili apartmanu. Jedan odgovorni tehnički kontakt za redovne obilaske, preventivu sistema i hitne popravke. Svaki rad i trošak se unaprijed odobravaju uz transparentne foto-izvještaje.</p>
            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <button type="button" data-service="facility" class="js-open-modal inline-flex items-center justify-center gap-2 rounded-xl bg-brand-blue px-6 py-3.5 text-base font-semibold text-white shadow-xl transition hover:bg-blue-500">
                <i data-lucide="messages-square" class="h-5 w-5"></i> Zatražite konsultaciju
              </button>
              <a href="tel:+38267163499" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-600 bg-slate-800/40 px-6 py-3.5 text-sm font-semibold text-white transition hover:border-slate-400 hover:bg-slate-700">
                <i data-lucide="phone" class="h-5 w-5"></i> Pozovi +382 67 163 499
              </a>
            </div>
          </div>
          <div class="relative hidden lg:block">
            <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border border-slate-700">
              <img src="/assets/img/odrzavanje-vila.jpg" alt="..." class="w-full h-full object-cover" width="1000" height="750" fetchpriority="high" decoding="async" />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="py-16 sm:py-20 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-extrabold text-slate-900 sm:text-3xl mb-8 text-center">Šta obuhvata naša usluga?</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-6 rounded-xl border border-slate-200 bg-slate-50">
            <i data-lucide="search" class="h-8 w-8 text-brand-blue mb-4"></i>
            <h3 class="font-bold text-slate-900 mb-2">Redovni tehnički pregledi</h3>
            <p class="text-sm text-slate-600">Preventivni obilasci objekta, provjera vlage, bezbjednosti i pravovremeno uočavanje problema prije nego što izazovu štetu.</p>
          </div>
          <div class="p-6 rounded-xl border border-slate-200 bg-slate-50">
            <i data-lucide="droplets" class="h-8 w-8 text-brand-blue mb-4"></i>
            <h3 class="font-bold text-slate-900 mb-2">Inženjerski sistemi</h3>
            <p class="text-sm text-slate-600">Stručna kontrola vodovoda, elektroinstalacija, klimatizacije, ventilacije i bazenske automatike.</p>
          </div>
          <div class="p-6 rounded-xl border border-slate-200 bg-slate-50">
            <i data-lucide="users" class="h-8 w-8 text-brand-blue mb-4"></i>
            <h3 class="font-bold text-slate-900 mb-2">Organizacija majstora</h3>
            <p class="text-sm text-slate-600">Mi pronalazimo, angažujemo i strogo kontrolišemo profilne stručnjake za specifične popravke.</p>
          </div>
          <div class="p-6 rounded-xl border border-slate-200 bg-slate-50">
            <i data-lucide="receipt" class="h-8 w-8 text-brand-blue mb-4"></i>
            <h3 class="font-bold text-slate-900 mb-2">Sve transparentno</h3>
            <p class="text-sm text-slate-600">Nijedan dodatni trošak ili popravka se ne izvode bez vašeg prethodnog odobrenja i jasnog predračuna.</p>
          </div>
          <div class="p-6 rounded-xl border border-slate-200 bg-slate-50">
            <i data-lucide="camera" class="h-8 w-8 text-brand-blue mb-4"></i>
            <h3 class="font-bold text-slate-900 mb-2">Foto izvještaji</h3>
            <p class="text-sm text-slate-600">Dobijate detaljan vizuelni dokaz o stanju objekta i obavljenim radovima (idealno za vlasnike koji nisu u zemlji).</p>
          </div>
          <div class="p-6 rounded-xl border border-slate-200 bg-slate-50">
            <i data-lucide="sun" class="h-8 w-8 text-brand-blue mb-4"></i>
            <h3 class="font-bold text-slate-900 mb-2">Priprema za sezonu</h3>
            <p class="text-sm text-slate-600">Kompletno aktiviranje sistema prije dolaska gostiju i bezbjedna konzervacija objekta van sezone.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- KAKO RADIMO (PROCESS BLOCK) -->
    <section class="bg-slate-50 py-16 border-y border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl font-bold text-slate-900">Kako radimo?</h2>
          <p class="mt-4 text-slate-600 max-w-2xl mx-auto">Četiri jednostavna koraka do potpunog mira i sigurnosti za vašu nekretninu.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
          <div class="relative flex flex-col items-center bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-brand-blue text-brand-blue flex items-center justify-center font-bold text-lg mb-4 shadow-sm z-10">1</div>
            <h3 class="text-base font-bold text-slate-800">Inicijalni pregled</h3>
            <p class="text-sm text-slate-500 mt-2">Besplatan izlazak i procjena stanja objekta.</p>
          </div>
          <div class="relative flex flex-col items-center bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center font-bold text-lg mb-4 shadow-sm z-10">2</div>
            <h3 class="text-base font-bold text-slate-800">Dogovor i plan</h3>
            <p class="text-sm text-slate-500 mt-2">Definisanje obaveza i učestalosti obilazaka.</p>
          </div>
          <div class="relative flex flex-col items-center bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center font-bold text-lg mb-4 shadow-sm z-10">3</div>
            <h3 class="text-base font-bold text-slate-800">Preuzimanje brige</h3>
            <p class="text-sm text-slate-500 mt-2">Redovna kontrola i tehničko održavanje.</p>
          </div>
          <div class="relative flex flex-col items-center bg-brand-dark p-6 rounded-2xl shadow-md text-white">
            <div class="h-12 w-12 rounded-full bg-brand-blue text-white flex items-center justify-center mb-4 shadow-md z-10"><i data-lucide="check" class="h-6 w-6"></i></div>
            <h3 class="text-base font-bold">Redovno izvještavanje</h3>
            <p class="text-sm text-slate-300 mt-2">Mir i sigurnost uz redovne foto-izvještaje.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <ContactModal />
</Layout>
