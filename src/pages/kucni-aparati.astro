---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---

<Layout title="Popravka kućnih aparata i bijele tehnike na vašoj adresi | Dobar Servis" description="Brza popravka frižidera, veš mašina, mašina za pranje sudova, bojlera i rerni na adresi. Obezbjeđujemo rezervne dijelove. Garancija do 12 mjeseci. ☎ +382 67 163 499">
  <Header />
<main>
    <!-- HERO -->
    <section class="relative overflow-hidden bg-brand-dark text-white py-16 lg:py-24">
      <div class="pointer-events-none absolute inset-0 opacity-[0.05]" style="background-image:linear-gradient(to right,#fff 1px,transparent 1px),linear-gradient(to bottom,#fff 1px,transparent 1px);background-size:64px 64px;"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-800/60 px-4 py-1.5 text-xs font-semibold text-slate-300">
              <i data-lucide="home" class="h-4 w-4 text-brand-blue"></i> Za domaćinstva • Izlazak na adresu • Obezbjeđujemo dijelove
            </span>
            <h1 class="mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">Brza popravka kućnih aparata na vašoj adresi</h1>
            <p class="mt-5 text-lg text-slate-300 leading-relaxed max-w-2xl">Servisiramo frižidere, veš mašine, mašine za pranje sudova, bojlere, štednjake i rerne. Dijagnostika kvara na licu mjesta, nabavka pouzdanih rezervnih dijelova, predračun prije početka rada i garancija do 12 mjeseci uz fiskalni račun.</p>
            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <button type="button" data-service="home" class="js-open-modal inline-flex items-center justify-center gap-2 rounded-xl bg-brand-blue px-6 py-3.5 text-base font-semibold text-white shadow-xl transition hover:bg-blue-500">
                <i data-lucide="calendar-check" class="h-5 w-5"></i> Zakaži majstora
              </button>
              <a href="tel:+38267163499" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-600 bg-slate-800/40 px-6 py-3.5 text-sm font-semibold text-white transition hover:border-slate-400 hover:bg-slate-700">
                <i data-lucide="phone" class="h-5 w-5"></i> Pozovi +382 67 163 499
              </a>
            </div>
          </div>
          <div class="relative hidden lg:block">
            <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border border-slate-700">
              <img src="/assets/img/kucni-aparati.jpg" alt="Popravka kućnih aparata i bijele tehnike na vašoj adresi - Dobar Servis" class="w-full h-full object-cover" width="1000" height="750" fetchpriority="high" decoding="async" />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="py-16 sm:py-20 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">Sa kojom opremom radimo?</h2>
          <p class="mt-4 text-slate-600 max-w-2xl mx-auto">Vršimo popravku i preventivno održavanje svih glavnih kategorija kućnih aparata.</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col">
            <i data-lucide="refrigerator" class="h-10 w-10 text-brand-blue mb-4"></i>
            <h3 class="text-lg font-bold text-slate-900">Frižideri i zamrzivači</h3>
            <p class="mt-2 text-sm text-slate-600 flex-1">Dijagnostika i zamjena kompresora, dopuna freona, popravka No Frost sistema, termostata i elektronike.</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col">
            <i data-lucide="washing-machine" class="h-10 w-10 text-brand-blue mb-4"></i>
            <h3 class="text-lg font-bold text-slate-900">Veš mašine i sušilice</h3>
            <p class="mt-2 text-sm text-slate-600 flex-1">Zamjena ležajeva, pumpi za vodu, grijača, remena, popravka elektronike i uklanjanje buke ili curenja.</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col">
            <i data-lucide="utensils" class="h-10 w-10 text-brand-blue mb-4"></i>
            <h3 class="text-lg font-bold text-slate-900">Mašine za pranje sudova</h3>
            <p class="mt-2 text-sm text-slate-600 flex-1">Rješavanje problema sa odvodom, grijanjem vode, pumpama visokog pritiska, doziranjem i začepljenjima.</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col">
            <i data-lucide="flame" class="h-10 w-10 text-brand-blue mb-4"></i>
            <h3 class="text-lg font-bold text-slate-900">Bojleri</h3>
            <p class="mt-2 text-sm text-slate-600 flex-1">Zamjena grijača i termostata, temeljno čišćenje kamenca, zamjena sigurnosnog ventila i otklanjanje curenja.</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col">
            <i data-lucide="microwave" class="h-10 w-10 text-brand-blue mb-4"></i>
            <h3 class="text-lg font-bold text-slate-900">Štednjaci, ploče i rerne</h3>
            <p class="mt-2 text-sm text-slate-600 flex-1">Popravka gornjih i donjih grijača, ventilatora, prekidača, staklokeramičkih ploča i senzora.</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm flex flex-col justify-center items-start border-brand-blue/30">
            <h3 class="text-lg font-bold text-brand-dark mb-2">Niste sigurni u kvar?</h3>
            <p class="text-sm text-slate-600 mb-4">Javite nam se, pomoći ćemo vam da utvrdimo problem i dogovorimo izlazak.</p>
            <button data-service="home" class="js-open-modal inline-flex items-center justify-center gap-2 rounded-lg bg-brand-blue px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark w-full sm:w-auto shadow-md">
              <i data-lucide="wrench" class="h-4 w-4"></i> Zakaži dijagnostiku
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- KAKO RADIMO (NEW BLOCK) -->
    <section class="bg-slate-50 py-16 border-y border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl font-bold text-slate-900">Kako funkcioniše servis?</h2>
          <p class="mt-4 text-slate-600 max-w-2xl mx-auto">Četiri jednostavna koraka do pouzdano popravljenog uređaja.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
          <div class="relative flex flex-col items-center bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-brand-blue text-brand-blue flex items-center justify-center font-bold text-lg mb-4 shadow-sm z-10">1</div>
            <h3 class="text-base font-bold text-slate-800">Prijava kvara</h3>
            <p class="text-sm text-slate-500 mt-2">Poziv ili poruka sa kratkim opisom problema.</p>
          </div>
          <div class="relative flex flex-col items-center bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center font-bold text-lg mb-4 shadow-sm z-10">2</div>
            <h3 class="text-base font-bold text-slate-800">Dolazak i dijagnostika</h3>
            <p class="text-sm text-slate-500 mt-2">Tačno utvrđivanje kvara na licu mjesta.</p>
          </div>
          <div class="relative flex flex-col items-center bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="h-12 w-12 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center font-bold text-lg mb-4 shadow-sm z-10">3</div>
            <h3 class="text-base font-bold text-slate-800">Predračun i dijelovi</h3>
            <p class="text-sm text-slate-500 mt-2">Jasna cijena prije rada. Mi nabavljamo rezervne dijelove.</p>
          </div>
          <div class="relative flex flex-col items-center bg-brand-dark p-6 rounded-2xl shadow-md text-white">
            <div class="h-12 w-12 rounded-full bg-brand-blue text-white flex items-center justify-center mb-4 shadow-md z-10"><i data-lucide="check" class="h-6 w-6"></i></div>
            <h3 class="text-base font-bold">Popravka sa garancijom</h3>
            <p class="text-sm text-slate-300 mt-2">Fiskalni račun i garancija do 12 mjeseci.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- GUARANTEE & TRUST (NEW BLOCK) -->
    <section class="py-16 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-3 gap-8">
          <div class="flex flex-col items-center text-center p-6">
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-light text-brand-blue mb-4">
              <i data-lucide="shield-check" class="h-7 w-7"></i>
            </span>
            <h3 class="text-lg font-bold text-slate-900">Garancija do 12 mjeseci</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">Na izvršene radove i ugrađene dijelove. Radimo pošteno i pouzdano.</p>
          </div>
          <div class="flex flex-col items-center text-center p-6">
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-light text-brand-blue mb-4">
              <i data-lucide="package" class="h-7 w-7"></i>
            </span>
            <h3 class="text-lg font-bold text-slate-900">Nabavka rezervnih dijelova</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">Ne morate sami tražiti komponente. Mi pronalazimo i donosimo potrebne dijelove.</p>
          </div>
          <div class="flex flex-col items-center text-center p-6">
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-light text-brand-blue mb-4">
              <i data-lucide="receipt" class="h-7 w-7"></i>
            </span>
            <h3 class="text-lg font-bold text-slate-900">Fiskalni račun</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">Potpuno legalno poslovanje D.O.O. Svaka intervencija je propraćena fiskalnim računom.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <ContactModal />
</Layout>
