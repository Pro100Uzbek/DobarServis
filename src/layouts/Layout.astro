---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Dobar Servis | Servis i održavanje u Crnoj Gori',
	description = 'Brza popravka kućnih aparata, servis profesionalne opreme za restorane i tehničko održavanje vila u Crnoj Gori. Garancija do 12 mjeseci.',
} = Astro.props;

const site = Astro.site ?? new URL('https://dobarservis.com');
const siteUrl = site.href;
const pagePath = Astro.url.pathname.replace(/^\/(?:en|ru)(?=\/|$)/, '') || '/';
const serbianUrl = new URL(pagePath, site).href;
const englishUrl = new URL(`/en${pagePath === '/' ? '/' : pagePath}`, site).href;
const russianUrl = new URL(`/ru${pagePath === '/' ? '/' : pagePath}`, site).href;
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const pageLanguage = /^\/en(?:\/|$)/.test(Astro.url.pathname)
	? 'en'
	: /^\/ru(?:\/|$)/.test(Astro.url.pathname)
		? 'ru'
		: 'sr-ME';

const businessId = `${siteUrl}#business`;
const structuredData = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'LocalBusiness',
			'@id': businessId,
			name: 'Dobar Servis D.O.O.',
			url: siteUrl,
			telephone: '+38267163499',
			email: 'info@dobarservis.com',
			areaServed: [
				'Ulcinj',
				'Bar',
				'Sutomore',
				'Petrovac',
				'Budva',
				'Tivat',
				'Kotor',
				'Herceg Novi',
				'Podgorica',
			],
			priceRange: '€€',
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Šušanjska bb',
				addressLocality: 'Bar',
				addressCountry: 'ME',
			},
		},
		{
			'@type': 'WebPage',
			'@id': `${canonicalUrl}#webpage`,
			url: canonicalUrl,
			name: title,
			description,
			inLanguage: pageLanguage,
			about: { '@id': businessId },
		},
	],
}).replace(/</g, '\\u003c');

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><g fill="none" stroke="#1E74BB" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"><path d="M32 5v54M8.6 18.5l46.8 27M8.6 45.5l46.8-27"/><path d="m25 12 7 7 7-7m-14 40 7-7 7 7M11 27l10 1 1-10m31 18-10-1-1 10M11 37l10-1 1 10m31-18-10 1-1-10"/></g></svg>`;
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<!DOCTYPE html>
<html lang="sr-ME" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={faviconHref} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="sr-ME" href={serbianUrl} />
		<!-- <link rel="alternate" hreflang="en" href={englishUrl} /> -->
		<!-- <link rel="alternate" hreflang="ru" href={russianUrl} /> -->
		<link rel="alternate" hreflang="x-default" href={serbianUrl} />
		<script type="application/ld+json" set:html={structuredData} />
		<script is:inline>
			(() => {
				const triggerEvents = ['scroll', 'mousemove', 'touchstart'];
				let gtmLoaded = false;
				let fallbackTimer;

				const loadGtm = () => {
					if (gtmLoaded) return;
					gtmLoaded = true;
					window.clearTimeout(fallbackTimer);
					triggerEvents.forEach((eventName) => {
						window.removeEventListener(eventName, loadGtm);
					});

					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });

					const script = document.createElement('script');
					script.async = true;
					script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-TD2M4L53';
					document.head.appendChild(script);
				};

				triggerEvents.forEach((eventName) => {
					window.addEventListener(eventName, loadGtm, { once: true, passive: true });
				});
				fallbackTimer = window.setTimeout(loadGtm, 2500);
			})();
		</script>
	</head>
	<body class="bg-white font-sans text-slate-900 antialiased pt-16 lg:pt-20 pb-20 lg:pb-0">
		<slot />
	</body>
</html>

<script>
	import {
		Beer,
		Briefcase,
		Building,
		Building2,
		CalendarCheck,
		Camera,
		Check,
		CheckCircle2,
		ChefHat,
		ChevronRight,
		ClipboardList,
		Clock,
		CreditCard,
		Droplets,
		FileCheck,
		FileText,
		Flame,
		Home,
		Mail,
		MapPin,
		Menu,
		MessageCircle,
		MessagesSquare,
		Microwave,
		Package,
		Phone,
		PhoneCall,
		Receipt,
		Refrigerator,
		Search,
		Send,
		ShieldCheck,
		Siren,
		Snowflake,
		Sun,
		Tag,
		Truck,
		User,
		Users,
		Utensils,
		WashingMachine,
		Wrench,
		X,
		createIcons,
	} from 'lucide';

	createIcons({
		icons: {
			Beer,
			Briefcase,
			Building,
			Building2,
			CalendarCheck,
			Camera,
			Check,
			CheckCircle2,
			ChefHat,
			ChevronRight,
			ClipboardList,
			Clock,
			CreditCard,
			Droplets,
			FileCheck,
			FileText,
			Flame,
			Home,
			Mail,
			MapPin,
			Menu,
			MessageCircle,
			MessagesSquare,
			Microwave,
			Package,
			Phone,
			PhoneCall,
			Receipt,
			Refrigerator,
			Search,
			Send,
			ShieldCheck,
			Siren,
			Snowflake,
			Sun,
			Tag,
			Truck,
			User,
			Users,
			Utensils,
			WashingMachine,
			Wrench,
			X,
		},
	});
</script>

<style is:global>
	@font-face {
		font-family: 'Inter';
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/inter-cyrillic-ext-wght-normal.woff2') format('woff2');
		unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F,
			U+FE2E-FE2F;
	}

	@font-face {
		font-family: 'Inter';
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/inter-cyrillic-wght-normal.woff2') format('woff2');
		unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
	}

	@font-face {
		font-family: 'Inter';
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/inter-latin-ext-wght-normal.woff2') format('woff2');
		unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
			U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020,
			U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
	}

	@font-face {
		font-family: 'Inter';
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/inter-latin-wght-normal.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
			U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
			U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	:root {
		--font-sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
	}
</style>
